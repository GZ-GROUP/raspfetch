# ---- Menu actions ----
feature1.name=System information
feature1.description=Shows the hostname, the kernel version and the uptime.
feature2.name=Memory check
feature2.description=Shows total, used and available RAM.
feature3.name=Storage check
feature3.description=Shows used and available space on the file systems.
feature4.name=Network configuration
feature4.description=Shows the network interfaces, their IP addresses and the configured routes.
feature5.name=Connectivity test
feature5.description=Asks for the IP address of another host on the LAN and checks whether it replies.
feature6.name=CPU temperature
feature6.description=Shows the temperature in degrees Celsius, or reports that the sensor is not available.
feature7.name=Active processes
feature7.description=Shows the running processes and their resource usage.
feature8.name=Create directory
feature8.description=Asks for a name and creates a folder inside the project working directory.
feature9.name=File permissions
feature9.description=Sets a file's owner permission to read only or read and write. The tool creates test_file.txt for this test.
feature10.name=Diagnostic report
feature10.description=Saves a summary of the system status, including date, user and hostname, to diagnostic_report.txt.

